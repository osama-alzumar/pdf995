# Copy to .env on the server. Never commit the real .env.
MAX_UPLOAD_MB=100
RETENTION_MINUTES=10
JOB_TIMEOUT_SECONDS=240
MAX_PARALLEL_JOBS=2
RATE_LIMIT_PER_MINUTE=20
# AI tools (summarize / ask / translate). Leave empty to keep them disabled.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Optional: path to the veraPDF CLI to validate PDF/A output against the standard.
VERAPDF_BIN=
