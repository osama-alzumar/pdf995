# HTTPS reverse proxy (automatic certificates). Replace the host name.
api.waraqa.example {
    request_body {
        max_size 110MB
    }
    reverse_proxy 127.0.0.1:8765 {
        transport http {
            read_timeout 300s
            write_timeout 300s
        }
    }
    header {
        Strict-Transport-Security "max-age=31536000"
        -Server
    }
    # No access log: Caddy logs nothing per request unless a `log` directive is added.
}
